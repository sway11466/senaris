; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Senaris"
config/description="ヘックス制ターン戦術SLG（Nectaris系をファンタジー化したオリジナル）"
config/version="0.3.0"
run/main_scene="res://presentation/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05098, 0.098039, 0.145098, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/menu/splash.png"
config/icon="res://assets/appicon/icon.png"
config/windows_native_icon="res://assets/appicon/icon.ico"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Senaris"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/dialogue.ja.translation", "res://data/i18n/dialogue.en.translation", "res://data/i18n/campaigns.ja.translation", "res://data/i18n/campaigns.en.translation", "res://data/i18n/manual.ja.translation", "res://data/i18n/manual.en.translation", "res://data/i18n/chronicle.ja.translation", "res://data/i18n/chronicle.en.translation", "res://data/i18n/map.ja.translation", "res://data/i18n/map.en.translation", "res://data/i18n/menu.ja.translation", "res://data/i18n/menu.en.translation", "res://data/i18n/settings.ja.translation", "res://data/i18n/settings.en.translation", "res://data/i18n/save.ja.translation", "res://data/i18n/save.en.translation", "res://data/i18n/report.ja.translation", "res://data/i18n/report.en.translation", "res://data/i18n/units.ja.translation", "res://data/i18n/units.en.translation", "res://data/i18n/terrain.ja.translation", "res://data/i18n/terrain.en.translation", "res://data/i18n/skills.ja.translation", "res://data/i18n/skills.en.translation", "res://data/i18n/ai.ja.translation", "res://data/i18n/ai.en.translation", "res://data/i18n/movement.ja.translation", "res://data/i18n/movement.en.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
