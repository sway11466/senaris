# Godot 4
.godot/
.import/
export.cfg

# Godot exports（リポジトリ直下の出力先だけ。godot/tools/build/ はビルドの道具なので追跡する）
/build/
*.exe
*.pck
*.zip

# BGM の中間生成物（.mscz から作り直せる）。ゲーム用の .ogg は assets/bgm/ にコミットする
godot/assets/bgm-src/**/*.wav
godot/assets/bgm-src/**/.mscbackup/

# 効果音の中間生成物（同上）。ゲーム用の音は assets/sfx/ にコミットする
godot/assets/sfx-src/**/*.wav
godot/assets/sfx-src/**/.mscbackup/
godot/assets/sfx-src/**/*.autosave

# Python (uv env for image-processing scripts)
.venv/
__pycache__/
*.pyc

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# pck 暗号化の鍵が入る。エディタがエクスポートダイアログを開くと勝手に作る（doc/tech/build.md）
godot/export_credentials.cfg
